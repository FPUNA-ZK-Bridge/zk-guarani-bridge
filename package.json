{
  "name": "guarani-bridge",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "node:n1": "hardhat node --port 8545",
    "node:n2": "anvil -p 9545 --chain-id 1338",
    "compile": "hardhat compile",
    "deploy:n1": "hardhat run scripts/deployN1.js --network $(node scripts/resolve-network.js n1)",
    "deploy:n2": "hardhat run scripts/deployN2.js --network $(node scripts/resolve-network.js n2)",
    "relayer": "node relayer/relayer.js",
    "frontend": "npx serve public",
    "test": "hardhat test",
    "coverage": "hardhat coverage --solcoverjs .solcover.cjs",
    "test:fast": "SKIP_ZK=1 hardhat test",
    "mutate:pretest": "SKIP_ZK=1 BRIDGE_ENV=local sumo pretest",
    "mutate:lookup": "sumo lookup",
    "mutate": "SKIP_ZK=1 BRIDGE_ENV=local sumo test"
  },
  "devDependencies": {
    "@morenabarboni/sumo": "^3.2.1",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "hardhat": "^2.22.2"
  },
  "dependencies": {
    "@chainsafe/ssz": "^0.15.1",
    "@lodestar/types": "^1.34.1",
    "@noble/curves": "^1.9.7",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.1",
    "ethers": "^6.15.0",
    "node-fetch": "^2.6.7",
    "poseidon-hash": "^1.0.1",
    "snarkjs": "^0.7.6"
  }
}
